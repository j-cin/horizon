{%- doc -%}
  Renders a compact list of complementary products with quick add, for the product page.
  Unlike the product recommendations block, it only ever uses `intent=complementary` and has no catalog fallback.
{%- enddoc -%}

{%- if closest.product != blank -%}
  <div
    class="complementary-products-block spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {% render 'complementary-products',
      product_id: closest.product.id,
      limit: block.settings.product_count,
      heading: block.settings.heading
    %}
  </div>
{%- endif -%}

{% stylesheet %}
  .complementary-products-block:not(:has(.complementary-products__item)) {
    padding-block: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.complementary_products",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.complementary_products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.complementary_products",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
